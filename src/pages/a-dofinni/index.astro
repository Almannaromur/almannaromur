---
/** Figma: 03 · Desktop screens / 05 News. Category filters on the left, results on the right. */
import Chip from '../../components/Chip.astro';
import NewsCard from '../../components/NewsCard.astro';
import PageHero from '../../components/PageHero.astro';
import { NEWS_CATEGORY_LABELS, useTranslations } from '../../i18n';
import Base from '../../layouts/Base.astro';
import { getNews } from '../../lib/content';

const t = useTranslations('is');
const news = await getNews();
const categories = Object.entries(NEWS_CATEGORY_LABELS);
// As on the old site: ten items at first, ten more with each press of "Sjá fleiri fréttir".
const PAGE_SIZE = 10;
---

<Base
  locale="is"
  title={t.nav.news}
  description="Fréttir, verkefni, viðburðir og útgefið efni frá Almannarómi."
  current="news"
  footerGap={120}
  footerHeight={715}
>
  <PageHero lines={[t.nav.news]} wash="blue" top={424} bottom={50} />

  <section class="page-frame">
    <!--
      Desktop, as on the old site: category filter in a left column, the list on the right, no
      hairline under the headline. Phones and tablets: a hairline, the filter in a row, then the list.
    -->
    <div class="grid grid-cols-1 border-t border-rule pt-8 md:grid-cols-[460fr_916fr] md:border-t-0 md:pt-0">
      <!-- Category filter. Without JavaScript the buttons stay hidden and every item is shown. -->
      <div
        role="group"
        aria-label="Sía eftir tegund"
        data-news-filter
        hidden
        class="-ml-0.5 flex flex-wrap content-start items-start gap-[11px] self-start md:pt-12"
      >
        <Chip variant="filter" size="md" data-filter="all" aria-pressed="true">{t.newsAll}</Chip>
        {
          categories.map(([value, label]) => (
            <Chip variant="filter" size="md" data-filter={value} aria-pressed="false">
              {label}
            </Chip>
          ))
        }
      </div>

      <div class="min-w-0">
        <div class="flex flex-col" data-news-list data-page-size={PAGE_SIZE}>
          {news.map((entry) => <NewsCard entry={entry} layout="list" />)}
        </div>
        <p class="type-body-24 py-10" data-news-empty hidden>{t.newsEmpty}</p>
        <!--
          Without JavaScript the button stays hidden and every item is shown.
          The space above and below it is the old site's (measured there with the button in place).
        -->
        <div class="flex justify-center pb-[174px] pt-40 md:pb-[150px] md:pt-[120px]" data-news-more hidden>
          <button
            type="button"
            class="h-10 w-40 cursor-pointer rounded-[10px] border border-brown text-xl leading-[1.34] transition-colors hover:bg-yellow"
          >
            {t.newsMore}
          </button>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const filter = document.querySelector<HTMLElement>('[data-news-filter]');
  const list = document.querySelector<HTMLElement>('[data-news-list]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-news-card]')];
  const empty = document.querySelector<HTMLElement>('[data-news-empty]');
  const more = document.querySelector<HTMLElement>('[data-news-more]');
  const pageSize = Number(list?.dataset.pageSize) || cards.length;

  if (filter) {
    filter.hidden = false;
    const buttons = [...filter.querySelectorAll<HTMLButtonElement>('button[data-filter]')];
    let category = 'all';
    let limit = pageSize;

    // Shows the first `limit` items of the chosen category and returns the ones that just appeared.
    const apply = () => {
      const appeared: HTMLElement[] = [];
      let matching = 0;
      for (const card of cards) {
        const match = category === 'all' || card.dataset.category === category;
        if (match) matching += 1;
        const show = match && matching <= limit;
        if (show && card.hidden) appeared.push(card);
        card.hidden = !show;
      }
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.filter === category));
      }
      if (empty) empty.hidden = matching > 0;
      if (more) more.hidden = matching <= limit;
      // Rows that moved up into view still need their scroll-in (see Base.astro).
      window.dispatchEvent(new Event('scroll'));
      return appeared;
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        category = button.dataset.filter ?? 'all';
        limit = pageSize;
        apply();
        // Keep the choice in the URL so a filtered view can be shared.
        const url = new URL(location.href);
        if (category === 'all') url.searchParams.delete('tegund');
        else url.searchParams.set('tegund', category);
        history.replaceState(null, '', url);
      });
    }

    more?.querySelector('button')?.addEventListener('click', () => {
      limit += pageSize;
      const [first] = apply();
      // Keyboard and screen-reader users continue from the first new item, not from a button
      // that has moved down the page or gone.
      first?.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
    });

    const initial = new URL(location.href).searchParams.get('tegund');
    if (initial && buttons.some((b) => b.dataset.filter === initial)) category = initial;
    apply();
  }
</script>
