---
/**
 * Lausnir & þjónusta. Layout and measurements follow the old site: every section
 * starts with a hairline and a 48px heading, 100px apart; solution cards turn
 * over when clicked.
 */
import { Image } from 'astro:assets';
import githubImage from '../assets/images/pages/github.png';
import huggingFaceImage from '../assets/images/pages/hugging-face.png';
import heroImage from '../assets/images/pages/lausnir-hero.png';
import languageBankImage from '../assets/images/pages/malbankinn.png';
import FeatureCard from '../components/FeatureCard.astro';
import { externalLinkAttrs } from '../lib/links';
import FlipCard from '../components/FlipCard.astro';
import PageHero from '../components/PageHero.astro';
import { solutions } from '../data/solutions';
import { otherLocale, projectPath, routes, useTranslations, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';
import { getProjects } from '../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const c = solutions[locale];

// "Lausnir & þjónusta" breaks after the ampersand in the design.
const [first, ...rest] = c.title.split('& ');
const heroLines = rest.length ? [`${first}&`, rest.join('& ')] : [c.title];

// Icons for the five solution cards, in the order of `languageTech.items`.
const iconFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/icons/solutions/*.svg', { eager: true });
const icons = ['speech-to-text', 'text-to-speech', 'translation', 'correction', 'resources'].map(
  (name) => iconFiles[`../assets/icons/solutions/${name}.svg`]?.default,
);

// Pictures for the three resource cards, in the order of `resources`.
const resourceImages = [languageBankImage, githubImage, huggingFaceImage];

const projects = await getProjects(locale);
const supportProjects = c.supportProjects.flatMap((slug) => projects.filter((p) => p.slug === slug));
// Shared pieces of the section pattern.
const section = 'border-t border-rule pt-10 pb-10 md:pt-[41px] md:pb-[42px]';
const gap = 'page-frame mt-16 md:mt-[100px]';
const heading = 'type-heading-48';
const shadow = 'shadow-[0_4px_20px_rgb(0_0_0/0.12)]';
---

<Base
  locale={locale}
  title={c.title}
  description={c.description}
  current="solutions"
  alternatePath={routes.solutions[otherLocale(locale)]}
  footerGap={99}
>
  <PageHero lines={heroLines} inline align="bottom" bottom={89} />

  <div class="page-frame">
    <Image
      src={heroImage}
      alt=""
      widths={[750, 1400, 2048]}
      sizes="(min-width: 1440px) 1376px, 100vw"
      loading="eager"
      class="h-[280px] w-full rounded-card object-cover md:h-[742px]"
    />
  </div>

  <!-- Maturity assessment -->
  <section class={gap} data-reveal>
    <div class:list={[section, 'split']}>
      <h2 class={heading}>{c.maturity.heading}</h2>
      <p class="type-body-20">{c.maturity.text}</p>
    </div>
  </section>

  <!-- Language technology: five cards that turn over when clicked. The last is two columns wide. -->
  <section class={gap} data-reveal>
    <div class={section}>
      <div class="split">
        <h2 class={heading}>{c.languageTech.heading}</h2>
        <div class="text-xl leading-[1.34]">{c.languageTech.intro.map((p) => <p>{p}</p>)}</div>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 md:mt-12 md:grid-cols-3">
        {
          c.languageTech.items.map((item, i) => (
            <FlipCard
              title={item.title}
              showLabel={t.flipShow}
              hideLabel={t.flipHide}
              frontClass={`bg-card px-6 pb-[46px] pt-[42px] ${shadow}`}
              backClass={`bg-blue px-6 pb-6 pt-[42px] ${shadow}`}
              class={i === c.languageTech.items.length - 1 ? 'sm:col-span-2' : undefined}
            >
              <Fragment slot="front">
                {icons[i] && <img src={icons[i].src} alt="" width={icons[i].width} height={icons[i].height} class="h-[30px] w-auto self-start" />}
                <h3 class="type-heading-32 mt-4">{item.title}</h3>
                {/* Links sit at the foot of the card; a longer list runs in two columns. */}
                <ul class:list={['type-label-20 mt-auto pt-6', item.links.length > 1 && 'gap-x-6 sm:columns-2']}>
                  {item.links.map((link) => (
                    <li class="break-inside-avoid pt-3 first:pt-0">
                      <a href={link.href} {...externalLinkAttrs(link.href)} class="hover:underline">
                        {link.label} →
                      </a>
                    </li>
                  ))}
                </ul>
              </Fragment>
              <p slot="back" class="leading-[1.34]">{item.text}</p>
            </FlipCard>
          ))
        }
      </div>
    </div>
  </section>

  {
    c.pillars.slice(0, -1).map((pillar) => (
      <section class={gap} data-reveal>
        <div class:list={[section, 'split']}>
          <h2 class={heading}>{pillar.heading}</h2>
          <p class="type-body-20">{pillar.text}</p>
        </div>
      </section>
    ))
  }

  <!-- Data: the last pillar, with its resource cards -->
  {
    c.pillars.slice(-1).map((pillar) => (
      <section class={gap} data-reveal>
        <div class={section}>
          <div class="split">
            <h2 class={heading}>{pillar.heading}</h2>
            <p class="type-body-20">{pillar.text}</p>
          </div>
          <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 md:mt-[42px] md:grid-cols-3">
            {c.resources.map((resource, i) => (
              <FeatureCard
                title={resource.title}
                description={resource.text}
                href={resource.href}
                image={resourceImages[i]}
                actionLabel={t.openSite}
                minHeight={475}
                imageHeight={201}
                tabletWide={c.resources.length % 2 === 1 && i === c.resources.length - 1}
              />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <!-- Support, with the programmes behind it -->
  <section class={gap} data-reveal>
    <div class={section}>
      <div class="split">
        <h2 class={heading}>{c.support.heading}</h2>
        <div class="type-body-20 flex flex-col gap-[26px]">{c.support.paragraphs.map((p) => <p>{p}</p>)}</div>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 md:mt-[42px] md:grid-cols-3">
        {
          supportProjects.map(({ slug, entry }, i) => (
            <FeatureCard
              title={entry.data.title}
              description={c.supportText?.[slug] ?? entry.data.summary}
              href={projectPath(locale, slug)}
              image={entry.data.image}
              actionLabel={t.readMore}
              minHeight={584}
              imageHeight={201}
              tabletWide={supportProjects.length % 2 === 1 && i === supportProjects.length - 1}
            />
          ))
        }
      </div>
    </div>
  </section>
</Base>
