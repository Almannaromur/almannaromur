---
/**
 * Um okkur / About. Layout, measurements and behaviour follow the old site:
 * every section starts with a hairline and a 48px heading; focus cards turn
 * over on hover; staff portraits show a description on hover; hovering a board
 * member's name shows that person's photo in place of the group photo.
 */
import { Image } from 'astro:assets';
import boardImage from '../assets/images/pages/stjorn.png';
import foundersImage from '../assets/images/pages/stofnadilar.png';
import Accordion from '../components/Accordion.astro';
import FlipCard from '../components/FlipCard.astro';
import PageHero from '../components/PageHero.astro';
import StaffCard from '../components/StaffCard.astro';
import { about } from '../data/about';
import { otherLocale, routes, useTranslations, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';
import { getStaff } from '../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = about[locale];
const t = useTranslations(locale);
const pageTitle = c.title.replace(/­/g, '');
const staff = await getStaff();

// "Hvað er / Almannarómur?": the organisation's name goes on its own line.
const split = c.title.lastIndexOf(' ');
const heroLines = split > 0 ? [c.title.slice(0, split), c.title.slice(split + 1)] : [c.title];

// Front of the three focus cards: blue, blue-to-yellow, yellow.
const FOCUS_TONES = [
  'bg-blue',
  'bg-[linear-gradient(198deg,#b8f2ff_0%,rgb(249_236_127/0.8)_100%)]',
  'bg-yellow/80',
];

// Board portraits: src/assets/images/board/<slug of the name>.(png|jpg)
const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/images/board/*.{png,jpg,jpeg,webp}', {
  eager: true,
});
const slugify = (name: string) =>
  name
    .toLowerCase()
    .replace(/þ/g, 'th')
    .replace(/ð/g, 'd')
    .replace(/æ/g, 'ae')
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
const portraitOf = (name: string) =>
  Object.entries(portraits).find(([file]) => file.split('/').pop()?.replace(/\.\w+$/, '') === slugify(name))?.[1]
    .default;

// Shared pieces of the section pattern.
const section = 'border-t border-rule pt-10 md:pt-[41px]';
const heading = 'type-heading-48';
const body = 'text-xl leading-[1.34]';
---

<Base
  locale={locale}
  title={pageTitle}
  description={c.description}
  current="about"
  alternatePath={routes.about[otherLocale(locale)]}
  footerGap={89}
>
  <div class="page-wash-yellow">
    <PageHero lines={heroLines} top={387} bottom={37} />

    <!-- Role -->
    <section class="page-frame pb-16 md:pb-[100px]">
      <div class:list={[section, 'split']}>
        <h2 class={heading}>{c.role.heading}</h2>
        <div class:list={[body, 'flex flex-col gap-6 md:gap-9']}>
          {c.role.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <!-- Focus areas: three cards that turn over to show the explanation -->
    <section class="page-frame pb-16 md:pb-[128px]" data-reveal>
      <div class={section}>
        <h2 class={heading}>{c.focus.heading}</h2>
        <div class="mt-8 grid grid-cols-1 gap-6 md:mt-[47px] md:grid-cols-3">
          {
            c.focus.items.map((item, i) => (
              <FlipCard
                title={item.title}
                showLabel={t.flipShow}
                hideLabel={t.flipHide}
                trigger="hover"
                frontClass={`${FOCUS_TONES[i % FOCUS_TONES.length]} px-[18px] pb-[42px] pt-8`}
                backClass="bg-canvas px-7 pb-11 pt-8"
                class="[--flip-h:519px] sm:max-md:[--flip-h:340px]"
              >
                <Fragment slot="front">
                  <span
                    class="self-end font-sans text-[240px] leading-[0.75] text-[rgb(253_248_238/0.6)] md:max-lg:text-[min(240px,calc(26vw-70px))]"
                    aria-hidden="true"
                  >
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3 class="type-heading-32 mt-auto md:max-lg:text-2xl">{item.title}</h3>
                </Fragment>
                <p slot="back" class="mt-auto text-2xl leading-[1.34] md:max-lg:text-xl">
                  {item.text}
                </p>
              </FlipCard>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  <!-- Results (this section and the staff section are inset 32px on the old site) -->
  <section class="page-frame pb-16 md:pb-[100px]" style="--page-gutter:32px" data-reveal>
    <div class:list={[section, 'split']}>
      <h2 class={heading}>{c.results.heading}</h2>
      <ol>
        {
          c.results.items.map((item, i) => (
            <li class="flex gap-6 border-b border-rule py-8 first:pt-0 last:border-b-0 last:pb-0 md:py-[42px]">
              <span class="shrink-0 text-sm leading-[26px] opacity-50">{String(i + 1).padStart(2, '0')}</span>
              <span class={body}>{item.text}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Founders -->
  <section class="page-frame pb-16 md:pb-[142px]">
    <div class={section}>
      <div class="split">
        <h2 class={heading}>{c.founders.heading}</h2>
        <p class="type-body-20 md:pt-1.5">{c.founders.text}</p>
      </div>
      <Image
        src={foundersImage}
        alt={c.founders.imageAlt}
        widths={[750, 1400, 2048]}
        sizes="(min-width: 1440px) 1376px, 100vw"
        class="mt-12 w-full md:mt-[100px]"
      />
    </div>
  </section>

  <!-- Staff (edited in Keystatic) -->
  <section class="page-frame pb-16 md:pb-[141px]" style="--page-gutter:32px">
    <div class={section}>
      <h2 class={heading}>{c.staffHeading}</h2>
      <ul class="mt-8 grid grid-cols-1 gap-x-6 gap-y-12 sm:grid-cols-2 md:mt-[47px] md:grid-cols-3 md:gap-y-[86px]">
        {staff.map((entry) => <StaffCard entry={entry} locale={locale} />)}
      </ul>
    </div>
  </section>

  <!-- Board: names on the left, photo on the right -->
  <section class="page-frame pb-16 md:pb-[140px]">
    <div class={section} data-board>
      <h2 class={heading}>{c.board.heading}</h2>
      <div class="mt-8 grid grid-cols-1 items-start gap-x-6 gap-y-10 md:mt-12 md:grid-cols-[440fr_911fr]">
        <div>
          <p class="type-body-20">{c.board.intro}</p>
          {
            c.board.groups.map((group) => (
              <div class="mt-8 md:mt-[42px]">
                <h3 class="type-label-20 font-medium">{group.label}:</h3>
                <ul class="type-label-20 mt-1.5 flex flex-col gap-1.5">
                  {group.members.map((member) => (
                    <li>
                      {portraitOf(member) ? (
                        <button
                          type="button"
                          class="board-name block w-full cursor-default text-left"
                          data-board-member={slugify(member)}
                        >
                          {member}
                        </button>
                      ) : (
                        member
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <div class="relative aspect-[911/606] overflow-clip rounded-card">
          <Image
            src={boardImage}
            alt={c.board.imageAlt}
            widths={[750, 1000, 1684]}
            sizes="(min-width: 1000px) 66vw, 100vw"
            class="size-full object-cover"
          />
          {
            c.board.groups
              .flatMap((group) => group.members)
              .map((member) => {
                const portrait = portraitOf(member);
                return (
                  portrait && (
                    <Image
                      src={portrait}
                      alt={member}
                      widths={[842]}
                      sizes="(min-width: 1000px) 66vw, 100vw"
                      loading="lazy"
                      class="board-photo absolute inset-0 size-full object-cover"
                      data-board-photo={slugify(member)}
                    />
                  )
                );
              })
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Advisory council -->
  <section class="page-frame pb-10 md:pb-[42px]">
    <div class:list={[section, 'split']}>
      <h2 class={heading}>{c.council.heading}</h2>
      <div class="min-w-0">
        <div class="type-body-20 flex flex-col gap-[26px]">
          {c.council.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <div class="mt-6">
          {
            c.council.members.map((member) => (
              <Accordion question={member.name}>
                <p>{member.bio}</p>
              </Accordion>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Board: show a member's portrait while their name is hovered or focused; a tap keeps it until the next tap.
  for (const board of document.querySelectorAll<HTMLElement>('[data-board]')) {
    const names = [...board.querySelectorAll<HTMLElement>('[data-board-member]')];
    const photos = [...board.querySelectorAll<HTMLElement>('[data-board-photo]')];
    let pinned: string | null = null;
    const show = (slug: string | null) => {
      for (const name of names) name.toggleAttribute('data-active', name.dataset.boardMember === slug);
      for (const photo of photos) photo.toggleAttribute('data-active', photo.dataset.boardPhoto === slug);
    };
    for (const name of names) {
      const slug = name.dataset.boardMember ?? null;
      name.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse') show(slug);
      });
      name.addEventListener('pointerleave', (event) => {
        if (event.pointerType === 'mouse') show(pinned);
      });
      name.addEventListener('focus', () => show(slug));
      name.addEventListener('blur', () => show(pinned));
      name.addEventListener('click', () => {
        pinned = pinned === slug ? null : slug;
        show(pinned);
      });
    }
  }
</script>
