---
// Roboto Serif with its optical-size axis; global.css pins it to the text cut used on the old site.
import '@fontsource-variable/roboto-serif/opsz.css';
import '@fontsource-variable/roboto-serif/opsz-italic.css';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { otherLocale, routes, useTranslations, type Locale, type RouteKey } from '../i18n';

interface Props {
  locale: Locale;
  /** Page title. Omit on the homepage. */
  title?: string;
  description?: string;
  /** Path of this page in the other language. `null` when it has no counterpart. */
  alternatePath?: string | null;
  /** Which top-level nav item to mark as current. */
  current?: RouteKey;
  /** Absolute or root-relative URL of the social sharing image. */
  image?: string;
  ogType?: 'website' | 'article';
  /** Space between the page content and the footer at desktop size, in px. */
  footerGap?: number;
  /** Height of the footer at full desktop size, in px. */
  footerHeight?: number;
  /** Side gutter of the page frame at desktop size, in px (24 everywhere except the homepage). */
  gutter?: 24 | 32;
}

const { locale, title, description, alternatePath = null, current, image, ogType = 'website', footerGap = 160, footerHeight, gutter = 24 } = Astro.props;
const t = useTranslations(locale);

const fullTitle = title ? `${title} | ${t.siteName}` : `${t.siteName} – ${t.siteTagline}`;
const metaDescription = description || t.siteDescription;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(pathname, Astro.site).href;
const other = otherLocale(locale);
const alternateHref = alternatePath ? new URL(alternatePath, Astro.site).href : null;
const ogImage = image ? new URL(image, Astro.site).href : null;
// The language switch falls back to the other language's homepage.
const switchPath = alternatePath ?? routes.home[other];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {
      alternateHref && (
        <>
          <link rel="alternate" hreflang={locale} href={canonical} />
          <link rel="alternate" hreflang={other} href={alternateHref} />
          <link rel="alternate" hreflang="x-default" href={locale === 'is' ? canonical : alternateHref} />
        </>
      )
    }
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'is' ? 'is_IS' : 'en_GB'} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" type="image/png" href="/favicon-light.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href="/favicon-dark.png" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Marks the page as scripted before first paint, so scroll-in blocks start hidden without a flash. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="relative flex min-h-dvh flex-col">
    <a
      href="#efni"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:rounded-control focus:bg-brown focus:px-4 focus:py-2 focus:text-canvas"
    >
      {t.skipToContent}
    </a>
    <Header locale={locale} current={current} switchPath={switchPath} />
    <main id="efni" class="flex-1" style={gutter === 24 ? undefined : `--page-gutter:${gutter}px`}>
      <slot />
    </main>
    <Footer locale={locale} gap={footerGap} height={footerHeight} />
    <!--
      Scroll-in (see [data-reveal] in global.css). A block is revealed once its resting
      position is 20% up from the bottom of the window. Blocks already on screen when
      the page opens are shown at once, without the animation.
    -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          // Long-form pages (Markdoc): each "##" section comes in as one block, led by its heading.
          for (const article of document.querySelectorAll('.prose-split > article')) {
            let lead = null;
            for (const el of article.children) {
              if (el.tagName === 'H2') lead = el;
              if (!lead) continue;
              el.setAttribute('data-reveal', '');
              el.revealLead = lead;
            }
          }
          let pending = [...document.querySelectorAll('[data-reveal]')];
          const offset = (el) => (el.dataset.reveal === 'up' ? 150 : el.dataset.reveal === 'fade' ? 0 : -150);
          // Resting position of the block (or of the heading that leads it), ignoring the hidden offset.
          const restingTop = (el) => {
            const lead = el.revealLead || el;
            return lead.getBoundingClientRect().top - (lead.classList.contains('is-revealed') ? 0 : offset(lead));
          };
          const check = (animate) => {
            const line = window.innerHeight * 0.8;
            const atEnd = window.innerHeight + window.scrollY >= root.scrollHeight - 160;
            // Measure everything first, then reveal, so a heading and its section go together.
            const due = pending.filter((el) => restingTop(el) <= line || (atEnd && el.dataset.reveal === 'up'));
            for (const el of due) {
              if (animate) el.classList.add('is-revealing');
              el.classList.add('is-revealed');
            }
            pending = pending.filter((el) => !due.includes(el));
            if (!pending.length) window.removeEventListener('scroll', onScroll);
          };
          let queued = false;
          const onScroll = () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(() => {
              queued = false;
              check(true);
            });
          };
          check(false);
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll);
        } catch {
          // Never leave content hidden if something goes wrong.
          root.classList.remove('js');
        }
      })();
    </script>
  </body>
</html>
