---
/** Markdoc tag {% band %}: a full-width tinted panel with a heading on the left and text on the right. */
interface Props {
  heading: string;
}

const { heading } = Astro.props;
---

<div
  class="not-prose span-full split rounded-card px-6 py-12 md:py-20"
  style="background: linear-gradient(248deg, rgb(129 138 166 / 0.5) 18%, rgb(217 173 184 / 0.5) 81%)"
>
  <p class="type-heading-48" role="heading" aria-level="2">{heading}</p>
  <div class="type-body-20 flex flex-col gap-6"><slot /></div>
</div>
