---
/**
 * Figma: AR / Person. Portrait, name and role. Content comes from Keystatic.
 * As on the old site, a blue panel with the person's description and email
 * covers the portrait while the pointer is over it; on touch screens it opens
 * and closes on tap.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  entry: CollectionEntry<'staff'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const t = useTranslations(locale);
const { name, titleIs, titleEn, noteIs, noteEn, bioIs, bioEn, email, photo } = entry.data;
// English falls back to Icelandic when a translation has not been entered.
const title = locale === 'en' ? titleEn || titleIs : titleIs;
const note = locale === 'en' ? noteEn || noteIs : noteIs;
const bio = locale === 'en' ? bioEn || bioIs : bioIs;
const role = [title, note && note.charAt(0).toLowerCase() + note.slice(1)].filter(Boolean).join(', ');
const hasPanel = Boolean(bio || email);
const panelId = `staff-${entry.id}`;
---

<li class="staff-card flex flex-col gap-6" data-staff-card>
  <div class="staff-media relative aspect-[438/442] overflow-clip rounded-card">
    {
      photo ? (
        <Image
          src={photo}
          alt={name}
          widths={[450, 900]}
          sizes="(min-width: 1000px) 33vw, (min-width: 700px) 50vw, 100vw"
          class="absolute inset-0 size-full object-cover"
        />
      ) : (
        <div class="size-full bg-blue" />
      )
    }
    {
      hasPanel && (
        <>
          <button
            type="button"
            class="absolute inset-0 cursor-default rounded-card"
            aria-expanded="false"
            aria-controls={panelId}
            aria-label={`${t.staffShowBio}: ${name}`}
            data-staff-toggle
          />
          {/* pointer-events: only the email link sits above the toggle */}
          <div
            id={panelId}
            class="staff-bio pointer-events-none absolute inset-0 flex flex-col gap-[23px] overflow-y-auto bg-blue p-5 text-base leading-[1.45] lg:p-8"
          >
            {bio && bio.split(/\n\s*\n/).map((paragraph) => <p>{paragraph}</p>)}
            {email && (
              <p>
                <a href={`mailto:${email}`} class="pointer-events-auto hover:underline">
                  {email}
                </a>
              </p>
            )}
          </div>
        </>
      )
    }
  </div>
  <div class="flex flex-col gap-[17px]">
    <h3 class="type-heading-32">{name}</h3>
    <p class="text-balance text-xl leading-[1.34]">{role}</p>
  </div>
</li>

<script>
  // Tap (or keyboard) opens and closes the description. With a mouse, hovering does it (see .staff-bio in global.css).
  for (const card of document.querySelectorAll<HTMLElement>('[data-staff-card]')) {
    const toggle = card.querySelector<HTMLButtonElement>('[data-staff-toggle]');
    if (!toggle) continue;
    const set = (open: boolean) => {
      card.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => set(!card.classList.contains('is-open')));
    card.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') set(false);
    });
  }
</script>
